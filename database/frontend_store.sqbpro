<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="frontend_store.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser query pragmas" current="2"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1703"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="ventas" custom_title="0" dock_id="1" table="4,6:mainventas"/><dock_state state="000000ff00000000fd0000000100000002000005f2000002a0fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000005f20000011100ffffff000005f20000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="carrito" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="71"/><column index="2" value="86"/><column index="3" value="59"/><column index="4" value="67"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="clientes" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="72"/><column index="2" value="63"/><column index="3" value="63"/><column index="4" value="55"/><column index="5" value="70"/><column index="6" value="57"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="detalles_venta" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="116"/><column index="2" value="67"/><column index="3" value="86"/><column index="4" value="59"/><column index="5" value="67"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="productos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="86"/><column index="2" value="63"/><column index="3" value="60"/><column index="4" value="53"/><column index="5" value="148"/><column index="6" value="70"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="ventas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="66"/><column index="2" value="74"/><column index="3" value="156"/><column index="4" value="44"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Productos">CREATE TABLE productos (
    id_producto INTEGER PRIMARY KEY,
    nombre      TEXT NOT NULL,
    imagen      TEXT,
    precio      REAL DEFAULT 0,
    descripcion TEXT,
    codigo      TEXT UNIQUE
)</sql><sql name="Clientes">CREATE TABLE clientes (
    id_cliente INTEGER PRIMARY KEY,
    nombre TEXT NOT NULL,
    telefono TEXT,
    direccion TEXT
);</sql><sql name="Ventas">CREATE TABLE ventas (
	id_venta INTEGER PRIMARY KEY,
	id_cliente INTEGER,
	fecha DATE,
	total REAL,
	FOREIGN KEY (id_cliente) REFERENCES clientes (id_cliente)
)</sql><sql name="Detalles_ventas">CREATE TABLE detalles_venta (
	id_detalles_venta INTEGER PRIMARY KEY,
	id_venta INTEGER,
	id_producto INTEGER,
	id_talla INTEGER,
	cantidad INTEGER,
	FOREIGN KEY (id_venta) REFERENCES ventas (id_venta),
	FOREIGN KEY (id_producto, id_talla) REFERENCES variantes_camisas (id_producto, id_talla)
)</sql><sql name="Pedidos*">CREATE TABLE pedidos (
	id_pedido INTEGER PRIMARY KEY,
	id_detalles_venta INTEGER,
	id_cliente
	FOREIGN KEY (id_detalles_venta) REFERENCES detalles_venta (id_detalles_venta),
	
)</sql><sql name="Usuarios">CREATE TABLE usuarios (
	id_usuario INTEGER PRIMARY KEY,
	email TEXT UNIQUE,
	password TEXT
)</sql><sql name="Tallas">CREATE TABLE tallas (
	id_talla INTEGER PRIMARY KEY,
	talla TEXT NOT NULL
)</sql><sql name="Variantes_Camisas">CREATE TABLE variantes_camisas (
    id_producto INTEGER,
    id_talla INTEGER,
    stock INTEGER DEFAULT 0,
	PRIMARY KEY (id_producto, id_talla),
    FOREIGN KEY (id_producto) REFERENCES productos (id_producto),
    FOREIGN KEY (id_talla) REFERENCES tallas (id_talla)
);</sql><sql name="Carrito">CREATE TABLE carrito (
	id_carrito INTEGER PRIMARY KEY,
	id_producto INTEGER,
	id_talla INTEGER,
	cantidad INTEGER DEFAULT 1,
	FOREIGN KEY (id_producto, id_talla) REFERENCES variantes_camisas (id_producto, id_talla)
)
</sql><sql name="sql*">SELECT 
	p.nombre AS producto, p.precio, p.imagen,
	t.talla, 
	v.total, 
	c.nombre AS cliente,
	dv.cantidad,
	(dv.cantidad * p.precio) AS subtotal
FROM detalles_venta dv
JOIN productos p ON dv.id_producto = p.id_producto
JOIN tallas t ON dv.id_talla = t.id_talla
JOIN ventas v ON dv.id_venta = v.id_venta
JOIN clientes c ON v.id_cliente = c.id_cliente</sql><current_tab id="9"/></tab_sql></sqlb_project>
