0"><sort><column index="1" mode="1"/></sort><column_widths><column index="1" value="86"/><column index="2" value="63"/><column index="3" value="53"/><column index="4" value="67"/><column index="5" value="83"/><column index="6" value="60"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="roles" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="50"/><column index="2" value="46"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="tallas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="59"/><column index="2" value="42"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="variantes_camisas" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="80"/><column index="2" value="86"/><column index="3" value="60"/><column index="4" value="47"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="Productos">CREATE TABLE productos (
    id_producto INTEGER PRIMARY KEY,
    nombre      TEXT NOT NULL,
    imagen      TEXT,
    precio      REAL DEFAULT 0,
    descripcion TEXT,
    codigo      TEXT UNIQUE
)</sql><sql name="Clientes">CREATE TABLE clientes (
    id_cliente  INTEGER PRIMARY KEY,
    nombre      TEXT NOT NULL,
    apellido    TEXT NOT NULL,
    cedula      TEXT NOT NULL UNIQUE,
    direccion   TEXT,
    cartera     REAL DEFAULT 0
);</sql><sql name="Ventas">CREATE TABLE ventas (
	id_venta INTEGER PRIMARY KEY,
	id_producto INTEGER,
	id_cliente INTEGER,
	fecha DATE,
	FOREIGN KEY (id_producto) REFERENCES productos (id_producto),
	FOREIGN KEY (id_cliente) REFERENCES clientes (id_cliente)
)</sql><sql name="Detalles_ventas">CREATE TABLE detalles_ventas (
	id_detalles_venta INTEGER PRIMARY KEY,
	id_venta INTEGER,
	id_producto INTEGER,
	id_cliente INTEGER,
	FOREIGN KEY (id_venta) REFERENCES ventas (id_venta),
	FOREIGN KEY (id_producto) REFERENCES productos (id_producto),
	FOREIGN KEY (id_cliente) REFERENCES clientes (id_cliente)
)</sql><sql name="Usuarios">CREATE TABLE usuarios (
	id_usuario INTEGER PRIMARY KEY,
	email TEXT UNIQUE,
	password TEXT,
	id_rol INTEGER,
	FOREIGN KEY (id_rol) REFERENCES roles (id_rol)
)</sql><sql name="Roles">CREATE TABLE roles (
	id_rol INTEGER PRIMARY KEY,
	rol TEXT NOT NULL UNIQUE
)
</sql><sql name="Tallas">CREATE TABLE tallas (
	id_talla INTEGER PRIMARY KEY,
	talla TEXT NOT NULL
)</sql><sql name="Variantes_Camisas*">CREATE TABLE variantes_camisas (
    id_producto INTEGER,
    id_talla INTEGER,
    stock INTEGER DEFAULT 0,
	PRIMARY KEY (id_producto, id_talla),
    FOREIGN KEY (id_producto) REFERENCES productos (id_producto),
    FOREIGN KEY (id_talla) REFERENCES tallas (id_talla)
);</sql><sql name="SQL*"></sql><current_tab id="8"/></tab_sql></sqlb_project>
